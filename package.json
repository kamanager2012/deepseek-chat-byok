{
  "name": "chat-demo",
  "version": "0.4.1",
  "description": "基于 DeepSeek API 的静态聊天示例。",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "rm -rf dist && NODE_ENV=production rspack build -c rspack.config.ts",
    "start": "node server.mjs",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "lint:extra": "oxlint server.mjs tests",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "android:sync": "node scripts/android-sync.mjs",
    "android:apk": "pnpm build && pnpm android:sync && gradle -p android :app:assembleDebug",
    "android:release": "pnpm build && pnpm android:sync && gradle -p android :app:assembleRelease"
  },
  "dependencies": {
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "^0.19.1",
    "mdast-util-find-and-replace": "3.0.2",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "^11.17.2",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/node": "~20.9.2",
    "fake-indexeddb": "^6.2.8",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "playwright-core": "^1.65.1",
    "typescript": "7.0.2",
    "vitest": "^4.1.12"
  }
}
